name: Signed desktop release

on:
  push:
    tags: ['v*.*.*']

permissions:
  contents: write
  id-token: write
  attestations: write

jobs:
  verify:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with: { go-version: '1.25.7' }
      - uses: actions/setup-node@v4
        with: { node-version: '22', cache: npm, cache-dependency-path: frontend/package-lock.json }
      - run: npm ci
        working-directory: frontend
      - run: ./scripts/check-runtime-paths.sh
      - run: go test -race ./...
      - run: npm test -- --run
        working-directory: frontend
      - run: npm run build
        working-directory: frontend

  macos:
    needs: verify
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }
      - uses: actions/setup-go@v5
        with: { go-version: '1.25.7' }
      - uses: actions/setup-node@v4
        with: { node-version: '22', cache: npm, cache-dependency-path: frontend/package-lock.json }
      - run: npm ci
        working-directory: frontend
      - run: go install github.com/wailsapp/wails/v2/cmd/wails@v2.15.0
      - name: Import Developer ID certificate
        env:
          MAC_CERT_P12_B64: ${{ secrets.MAC_CERT_P12_B64 }}
          MAC_CERT_PASSWORD: ${{ secrets.MAC_CERT_PASSWORD }}
          MAC_INSTALLER_CERT_P12_B64: ${{ secrets.MAC_INSTALLER_CERT_P12_B64 }}
          MAC_INSTALLER_CERT_PASSWORD: ${{ secrets.MAC_INSTALLER_CERT_PASSWORD }}
        run: |
          security create-keychain -p actions build.keychain
          security default-keychain -s build.keychain
          security unlock-keychain -p actions build.keychain
          echo "$MAC_CERT_P12_B64" | base64 --decode > certificate.p12
          security import certificate.p12 -k build.keychain -P "$MAC_CERT_PASSWORD" -T /usr/bin/codesign
          echo "$MAC_INSTALLER_CERT_P12_B64" | base64 --decode > installer-certificate.p12
          security import installer-certificate.p12 -k build.keychain -P "$MAC_INSTALLER_CERT_PASSWORD" -T /usr/bin/productbuild
          security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k actions build.keychain
      - name: Configure notarization
        env:
          APPLE_ID: ${{ secrets.APPLE_ID }}
          APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
          APPLE_APP_PASSWORD: ${{ secrets.APPLE_APP_PASSWORD }}
        run: xcrun notarytool store-credentials quotier-ci --apple-id "$APPLE_ID" --team-id "$APPLE_TEAM_ID" --password "$APPLE_APP_PASSWORD"
      - name: Build, sign, notarize
        env:
          APPLE_DEVELOPER_ID_APPLICATION: ${{ secrets.APPLE_DEVELOPER_ID_APPLICATION }}
          APPLE_DEVELOPER_ID_INSTALLER: ${{ secrets.APPLE_DEVELOPER_ID_INSTALLER }}
          APPLE_NOTARY_PROFILE: quotier-ci
          QUOTIER_UPDATE_PUBLIC_KEY: ${{ secrets.QUOTIER_UPDATE_PUBLIC_KEY }}
        run: ./scripts/package-macos.sh
      - uses: actions/upload-artifact@v4
        with: { name: macos-release, path: release-artifacts/* }

  windows:
    needs: verify
    runs-on: windows-2025
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }
      - uses: actions/setup-go@v5
        with: { go-version: '1.25.7' }
      - uses: actions/setup-node@v4
        with: { node-version: '22', cache: npm, cache-dependency-path: frontend/package-lock.json }
      - run: npm ci
        working-directory: frontend
      - run: go install github.com/wailsapp/wails/v2/cmd/wails@v2.15.0
      - run: choco install nsis windows-sdk-10-version-2004-all -y
      - name: Import Authenticode certificate
        shell: pwsh
        env:
          WINDOWS_CERT_PFX_B64: ${{ secrets.WINDOWS_CERT_PFX_B64 }}
          WINDOWS_CERT_PASSWORD: ${{ secrets.WINDOWS_CERT_PASSWORD }}
        run: |
          [IO.File]::WriteAllBytes('certificate.pfx', [Convert]::FromBase64String($env:WINDOWS_CERT_PFX_B64))
          $secure = ConvertTo-SecureString $env:WINDOWS_CERT_PASSWORD -AsPlainText -Force
          $cert = Import-PfxCertificate -FilePath certificate.pfx -CertStoreLocation Cert:\CurrentUser\My -Password $secure
          "QUOTIER_WINDOWS_CERT_SHA1=$($cert.Thumbprint)" | Out-File -FilePath $env:GITHUB_ENV -Append
      - name: Build and sign
        shell: bash
        env:
          QUOTIER_UPDATE_PUBLIC_KEY: ${{ secrets.QUOTIER_UPDATE_PUBLIC_KEY }}
        run: ./scripts/package-windows.sh
      - uses: actions/upload-artifact@v4
        with: { name: windows-release, path: release-artifacts/* }

  linux:
    needs: verify
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }
      - uses: actions/setup-go@v5
        with: { go-version: '1.25.7' }
      - uses: actions/setup-node@v4
        with: { node-version: '22', cache: npm, cache-dependency-path: frontend/package-lock.json }
      - run: sudo apt-get update && sudo apt-get install -y libgtk-3-dev libwebkit2gtk-4.1-dev desktop-file-utils dpkg-dev
      - name: Import Linux release signing key
        env:
          LINUX_GPG_PRIVATE_KEY_B64: ${{ secrets.LINUX_GPG_PRIVATE_KEY_B64 }}
        run: echo "$LINUX_GPG_PRIVATE_KEY_B64" | base64 --decode | gpg --batch --import
      - run: npm ci
        working-directory: frontend
      - run: go install github.com/wailsapp/wails/v2/cmd/wails@v2.15.0
      - name: Build package
        env:
          QUOTIER_UPDATE_PUBLIC_KEY: ${{ secrets.QUOTIER_UPDATE_PUBLIC_KEY }}
          QUOTIER_LINUX_GPG_KEY: ${{ secrets.QUOTIER_LINUX_GPG_KEY }}
        run: ./scripts/package-linux.sh
      - uses: actions/upload-artifact@v4
        with: { name: linux-release, path: release-artifacts/* }

  publish:
    needs: [macos, windows, linux]
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }
      - uses: actions/setup-node@v4
        with: { node-version: '22' }
      - uses: actions/download-artifact@v4
        with: { pattern: '*-release', path: release-artifacts, merge-multiple: true }
      - name: Create protected update key
        env:
          UPDATE_PRIVATE_KEY_PEM_B64: ${{ secrets.UPDATE_PRIVATE_KEY_PEM_B64 }}
        run: echo "$UPDATE_PRIVATE_KEY_PEM_B64" | base64 --decode > "$RUNNER_TEMP/update-key.pem"
      - name: Sign update metadata
        env:
          QUOTIER_UPDATE_PRIVATE_KEY_FILE: ${{ runner.temp }}/update-key.pem
          QUOTIER_UPDATE_PUBLIC_KEY: ${{ secrets.QUOTIER_UPDATE_PUBLIC_KEY }}
          QUOTIER_MINIMUM_SOURCE_VERSION: ${{ vars.QUOTIER_MINIMUM_SOURCE_VERSION }}
          QUOTIER_MINIMUM_DB_SCHEMA: ${{ vars.QUOTIER_MINIMUM_DB_SCHEMA }}
        run: ./scripts/finalize-release.sh
      - uses: anchore/sbom-action@v0
        with: { path: '.', format: cyclonedx-json, output-file: release-artifacts/sbom.cdx.json }
      - uses: actions/attest-build-provenance@v2
        with: { subject-path: 'release-artifacts/*' }
      - uses: softprops/action-gh-release@v2
        with:
          draft: true
          generate_release_notes: true
          files: release-artifacts/*
